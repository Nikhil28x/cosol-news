# ===========================================================================
# Account Intel — environment template. Copy to .env and fill in.
# ===========================================================================

# Supabase Postgres. Dev/migrations: pooler SESSION mode (:5432).
# Vercel/serverless: pooler TRANSACTION mode (:6543). Pooler username is
# "postgres.<project-ref>". URL-encode special chars in the password ("$" -> "%24").
# SSL is required.
DATABASE_URL=

# Secret guarding /watch/api/cron/ingest: generate with `openssl rand -hex 32`.
CRON_SECRET=

# OpenRouter (OpenAI-compatible) for news enrichment. Blank => keyword heuristics.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional paid news adapters — leave blank to use free Google News RSS.
TAVILY_API_KEY=
NEWSAPI_KEY=

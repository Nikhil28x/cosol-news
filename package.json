{
	"name": "cosol-news",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"db:check": "tsx scripts/db-check.ts",
		"watch:build-seed": "tsx scripts/build-seed.ts",
		"watch:seed": "tsx scripts/seed.ts",
		"watch:ingest": "tsx scripts/ingest.ts",
		"watch:reenrich": "tsx scripts/reenrich.ts",
		"watch:scheduler": "tsx scripts/scheduler.ts",
		"watch:images": "tsx scripts/enrich-images.ts",
		"watch:tech": "tsx scripts/general-news.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^25.9.3",
		"drizzle-kit": "^0.31.10",
		"prettier": "^3.8.4",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tsx": "^4.23.1",
		"typescript": "^6.0.3",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"bcryptjs": "^3.0.3",
		"drizzle-orm": "^0.45.2",
		"fast-xml-parser": "^5.10.0",
		"postgres": "^3.4.9",
		"zod": "^4.4.3"
	}
}
